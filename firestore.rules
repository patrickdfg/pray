rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null && request.auth.token.firebase.sign_in_provider in ['google.com','anonymous','password']; }
  function permanent() { return signed() && request.auth.token.firebase.sign_in_provider in ['google.com','password']; }
  function me() { return request.auth.uid; }
  function profile() { return get(/databases/$(database)/documents/profiles/$(me())).data; }
  function member(team) { return signed() && exists(/databases/$(database)/documents/teams/$(team)/members/$(me())); }
  function validKey(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,100}$'); }
  function freshEvent(team,item,event,kind) {
   let path = /databases/$(database)/documents/teams/$(team)/items/$(item)/events/$(event);
   return validKey(event) && !exists(path) && getAfter(path).data.uid == me() && getAfter(path).data.kind == kind && getAfter(path).data.at == request.time;
  }
  function rewardUpdate() {
   let p = request.resource.data;
   let r = p.lastEvent;
   let e = getAfter(/databases/$(database)/documents/teams/$(r.team)/items/$(r.item)/events/$(r.event)).data;
   let day = int((request.time.toMillis() + 32400000) / 86400000);
   return p.diff(resource.data).affectedKeys().hasOnly(['xp','coins','lastEvent','dailyDay','dailyCount'])
    && r is map && r.keys().hasOnly(['team','item','event']) && validKey(r.team) && validKey(r.item) && validKey(r.event)
    && freshEvent(r.team,r.item,r.event,e.kind) && e.kind in ['log','complete']
    && p.xp == resource.data.xp + (e.kind == 'log' ? 10 : 20)
    && p.coins == resource.data.coins + (e.kind == 'log' ? 2 : 5)
    && p.dailyDay == day && p.dailyCount == (resource.data.dailyDay == day ? resource.data.dailyCount + 1 : 1);
  }
  function purchaseUpdate() {
   let next = request.resource.data;
   let owned = resource.data.decorations;
   let added = next.decorations[owned.size()];
   let prices = {'flower':20,'lantern':50,'fountain':100};
   return next.diff(resource.data).affectedKeys().hasOnly(['coins','decorations'])
    && next.decorations.size() == owned.size() + 1 && next.decorations == owned.concat([added])
    && added in ['flower','lantern','fountain'] && !(added in owned)
    && next.coins == resource.data.coins - prices[added] && next.coins >= 0;
  }
  match /profiles/{uid} {
   allow get: if signed() && uid == me();
   allow create: if signed() && uid == me()
    && request.resource.data.keys().hasOnly(['uid','name','xp','coins','decorations','activeTeam','createdAt','dailyDay','dailyCount','lastEvent','accountKind'])
    && request.resource.data.get('accountKind','permanent') == (permanent() ? 'permanent' : 'guest')
    && request.resource.data.uid == uid && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
    && request.resource.data.xp == 0 && request.resource.data.coins == 0 && request.resource.data.decorations == [] && request.resource.data.activeTeam == ''
    && request.resource.data.createdAt == request.time && request.resource.data.dailyDay == 0 && request.resource.data.dailyCount == 0 && request.resource.data.lastEvent == null;
   allow update: if signed() && uid == me() && (
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeTeam']) && resource.data.activeTeam == '' && validKey(request.resource.data.activeTeam)
     && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.activeTeam)/members/$(uid)).data.uid == uid
     && !exists(/databases/$(database)/documents/teams/$(request.resource.data.activeTeam)/members/$(uid)))
    || purchaseUpdate()
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountKind']) && request.resource.data.accountKind == (permanent() ? 'permanent' : 'guest'))
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeCircle']) && resource.data.get('activeCircle','') == '' && validKey(request.resource.data.activeCircle)
     && (getAfter(/databases/$(database)/documents/circles/$(request.resource.data.activeCircle)).data.director == me()
       || getAfter(/databases/$(database)/documents/circles/$(request.resource.data.activeCircle)/requests/$(me())).data.uid == me()))
    || (request.resource.data.lastEvent is map && 'team' in request.resource.data.lastEvent && rewardUpdate())
    || (request.resource.data.lastEvent is map && 'circle' in request.resource.data.lastEvent && circleRewardUpdate()));
  }
  match /teams/{team} {
   allow get: if member(team);
   allow create: if permanent() && validKey(team)
    && request.resource.data.keys().hasOnly(['name','leader','createdAt','memberCount','itemCount','lastMember','lastItem'])
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
    && request.resource.data.leader == me() && request.resource.data.createdAt == request.time
    && request.resource.data.memberCount == 1 && request.resource.data.itemCount == 0 && request.resource.data.lastMember == me() && request.resource.data.lastItem == ''
    && profile().activeTeam == '' && getAfter(/databases/$(database)/documents/profiles/$(me())).data.activeTeam == team
    && getAfter(/databases/$(database)/documents/teams/$(team)/members/$(me())).data.role == 'leader';
   allow update: if signed() && (
    (member(team) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itemCount','lastItem'])
     && request.resource.data.itemCount == resource.data.itemCount + 1
     && validKey(request.resource.data.lastItem)
     && !exists(/databases/$(database)/documents/teams/$(team)/items/$(request.resource.data.lastItem))
     && getAfter(/databases/$(database)/documents/teams/$(team)/items/$(request.resource.data.lastItem)).data.author == me()
     && getAfter(/databases/$(database)/documents/teams/$(team)/items/$(request.resource.data.lastItem)).data.createdAt == request.time)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','lastMember'])
     && request.resource.data.memberCount == resource.data.memberCount + 1 && request.resource.data.lastMember == me()
     && !exists(/databases/$(database)/documents/teams/$(team)/members/$(me()))
     && getAfter(/databases/$(database)/documents/teams/$(team)/members/$(me())).data.joinedAt == request.time));
   match /members/{uid} {
    allow get: if signed() && (uid == me() || member(team));
    allow list: if member(team) && request.query.limit <= 100;
    allow create: if signed() && uid == me() && profile().activeTeam == ''
     && request.resource.data.keys().hasOnly(['uid','name','parentUid','role','inviteToken','joinedAt'])
     && request.resource.data.uid == uid && request.resource.data.name == profile().name && request.resource.data.joinedAt == request.time
     && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.activeTeam == team
     && ((request.resource.data.role == 'leader' && request.resource.data.parentUid == '' && request.resource.data.inviteToken == ''
       && !exists(/databases/$(database)/documents/teams/$(team)) && getAfter(/databases/$(database)/documents/teams/$(team)).data.leader == uid)
      || (request.resource.data.role == 'member' && validKey(request.resource.data.inviteToken) && validInvite(team,request.resource.data.inviteToken,request.resource.data.parentUid)
       && getAfter(/databases/$(database)/documents/teams/$(team)).data.memberCount == get(/databases/$(database)/documents/teams/$(team)).data.memberCount + 1));
   }
   match /items/{item} {
    allow get: if member(team);
    allow list: if member(team) && request.query.limit <= 100;
    allow create: if member(team) && validKey(item)
     && request.resource.data.keys().hasOnly(['title','body','kind','secret','author','authorName','count','myCount','createdAt','comments','outcomes','source','lastActor','eventId','lastLog'])
     && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
     && request.resource.data.body is string && request.resource.data.body.size() <= 3000 && request.resource.data.kind in ['prayer','task']
     && request.resource.data.secret == false && request.resource.data.author == me() && request.resource.data.authorName == profile().name
     && request.resource.data.count == 0 && request.resource.data.myCount == 0 && request.resource.data.createdAt == request.time && request.resource.data.comments == [] && request.resource.data.outcomes == {}
     && request.resource.data.lastActor == '' && request.resource.data.eventId == '' && request.resource.data.lastLog == null
     && request.resource.data.source == (get(/databases/$(database)/documents/teams/$(team)).data.leader == me() ? '팀장에게서 왔어요' : '')
     && getAfter(/databases/$(database)/documents/teams/$(team)).data.lastItem == item
     && getAfter(/databases/$(database)/documents/teams/$(team)).data.itemCount == get(/databases/$(database)/documents/teams/$(team)).data.itemCount + 1;
    allow update: if member(team) && (editUpdate() || logUpdate(team,item) || outcomeUpdate(team,item) || commentUpdate());
    function editUpdate() {
     let p=request.resource.data;
     return resource.data.author == me() && resource.data.outcomes.get(me(),null) == null
      && p.diff(resource.data).affectedKeys().hasOnly(['title','body'])
      && p.title is string && p.title.matches('.*[^\\s].*') && p.title.size() <= 100
      && p.body is string && p.body.size() <= 3000;
    }
    function logUpdate(team,item) {
     let p=request.resource.data;
     return p.diff(resource.data).affectedKeys().hasOnly(['count','lastLog','lastActor','eventId'])
      && resource.data.outcomes.get(me(),null) == null && p.count == resource.data.count + 1 && p.lastLog == request.time && p.lastActor == me()
      && freshEvent(team,item,p.eventId,'log') && getAfter(/databases/$(database)/documents/teams/$(team)/items/$(item)/actors/$(me())).data.lastEvent == p.eventId;
    }
    function outcomeUpdate(team,item) {
     let p=request.resource.data;
     let outcome=p.outcomes[me()];
     return p.diff(resource.data).affectedKeys().hasOnly(['outcomes','lastActor','eventId']) && p.lastActor == me()
      && resource.data.outcomes.get(me(),null) == null && p.outcomes.diff(resource.data.outcomes).affectedKeys().hasOnly([me()])
      && outcome.keys().hasOnly(['rating','completedAt','count']) && outcome.rating is int && outcome.rating >= 1 && outcome.rating <= 5
      && outcome.completedAt == request.time && outcome.count == resource.data.count && freshEvent(team,item,p.eventId,'complete');
    }
    function commentUpdate() {
     let p=request.resource.data;
     let c=p.comments[resource.data.comments.size()];
     return p.diff(resource.data).affectedKeys().hasOnly(['comments'])
      && p.comments.size() == resource.data.comments.size() + 1 && p.comments == resource.data.comments.concat([c])
      && c.keys().hasOnly(['id','name','text','at']) && validKey(c.id) && c.name == profile().name && c.text is string && c.text.size() > 0 && c.text.size() <= 1000
      && c.at is timestamp && c.at >= request.time - duration.value(1,'m') && c.at <= request.time + duration.value(1,'m');
    }
    match /actors/{uid} {
     allow get: if member(team) && uid == me();
     allow create,update: if member(team) && uid == me()
      && request.resource.data.keys().hasOnly(['uid','count','lastLog','lastEvent']) && request.resource.data.uid == uid
      && request.resource.data.lastLog == request.time && request.resource.data.count == (resource == null ? 1 : resource.data.count + 1)
      && (resource == null || request.time >= resource.data.lastLog + duration.value(3,'s')) && freshEvent(team,item,request.resource.data.lastEvent,'log');
    }
    match /events/{event} {
     allow get: if member(team) && (resource == null || resource.data.uid == me());
     allow create: if member(team) && validKey(event) && request.resource.data.keys().hasOnly(['uid','kind','at'])
      && request.resource.data.uid == me() && request.resource.data.kind in ['log','complete'] && request.resource.data.at == request.time
      && getAfter(/databases/$(database)/documents/profiles/$(me())).data.lastEvent == {'team':team,'item':item,'event':event}
      && getAfter(/databases/$(database)/documents/teams/$(team)/items/$(item)).data.eventId == event
      && getAfter(/databases/$(database)/documents/teams/$(team)/items/$(item)).data.lastActor == me()
      && ((request.resource.data.kind == 'log' && getAfter(/databases/$(database)/documents/teams/$(team)/items/$(item)).data.lastLog == request.time
       && getAfter(/databases/$(database)/documents/teams/$(team)/items/$(item)/actors/$(me())).data.lastEvent == event)
       || (request.resource.data.kind == 'complete' && getAfter(/databases/$(database)/documents/teams/$(team)/items/$(item)).data.outcomes[me()].completedAt == request.time));
    }
   }
  }
  function validInvite(team,token,parent) {
   let i=get(/databases/$(database)/documents/invites/$(token)).data;
   return i.team == team && i.parentUid == parent && i.expiresAt > request.time
    && exists(/databases/$(database)/documents/teams/$(team)/members/$(parent))
    && getAfter(/databases/$(database)/documents/invites/$(token)).data.uses == i.uses + 1;
  }
  match /invites/{token} {
   allow get: if signed();
   allow create: if signed() && token.matches('^[a-f0-9]{48}$')
    && request.resource.data.keys().hasOnly(['team','parentUid','createdAt','expiresAt','uses'])
    && member(request.resource.data.team) && request.resource.data.parentUid == me() && request.resource.data.createdAt == request.time
    && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(8,'d') && request.resource.data.uses == 0;
   allow update: if signed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']) && resource.data.expiresAt > request.time
    && request.resource.data.uses == resource.data.uses + 1
    && !exists(/databases/$(database)/documents/teams/$(resource.data.team)/members/$(me()))
    && getAfter(/databases/$(database)/documents/teams/$(resource.data.team)/members/$(me())).data.inviteToken == token
    && getAfter(/databases/$(database)/documents/teams/$(resource.data.team)/members/$(me())).data.joinedAt == request.time;
  }
  function circleData(id) { return get(/databases/$(database)/documents/circles/$(id)).data; }
  function circleMember(id) { return signed() && (circleData(id).get('schema',2) == 3 ? exists(/databases/$(database)/documents/circles/$(id)/members/$(me())) : me() in circleData(id).people); }
  function circleManager(id,team) { let c=circleData(id); return c.get('schema',2) == 3 ? circleMember(id) && (c.director == me() || get(/databases/$(database)/documents/circles/$(id)/teamDocs/$(team)).data.leader == me()) : permanent() && (c.director == me() || c.teams[team].leader == me()); }
  function circlePerson(id,uid) { let c=circleData(id); return c.get('schema',2) == 3 ? get(/databases/$(database)/documents/circles/$(id)/members/$(uid)).data : c.people[uid]; }
  function circleCanRead(id,team) { let c=circleData(id); return circleMember(id) && (c.director == me() || team == 'all' || team == circlePerson(id,me()).team || (c.get('schema',2) == 3 && circleManager(id,team))); }
  function circleEvent(id,item,event,kind) {
   let path=/databases/$(database)/documents/circles/$(id)/entries/$(item)/events/$(event);
   return validKey(event) && !exists(path) && getAfter(path).data == {'uid':me(),'kind':kind,'at':request.time};
  }
  function circleRewardUpdate() {
   let p=request.resource.data; let r=p.lastEvent;
   let path=/databases/$(database)/documents/circles/$(r.circle)/entries/$(r.item)/events/$(r.event);
   let e=getAfter(path).data; let day=int((request.time.toMillis() + 32400000) / 86400000);
   return p.diff(resource.data).affectedKeys().hasOnly(['xp','coins','lastEvent','dailyDay','dailyCount'])
    && r.keys().hasOnly(['circle','item','event']) && validKey(r.circle) && validKey(r.item) && validKey(r.event)
    && !exists(path) && e.uid == me() && e.at == request.time && e.kind in ['log','complete']
    && p.xp == resource.data.xp + (e.kind == 'log' ? 10 : 20) && p.coins == resource.data.coins + (e.kind == 'log' ? 2 : 5)
    && p.dailyDay == day && p.dailyCount == (resource.data.dailyDay == day ? resource.data.dailyCount+1 : 1);
  }
  match /circleGates/{proof} {
   // Admission secrets are non-listable, derived using PBKDF2; plaintext is never stored.
   allow get: if signed();
   allow create,update: if signed() && proof.matches('^[a-f0-9]{64}$')
    && request.resource.data.keys().hasOnly(['circle','team','code'])
    && validKey(request.resource.data.circle) && validKey(request.resource.data.team)
    && request.resource.data.code.matches('^[A-Z0-9]{8,16}$')
    && circleManager(request.resource.data.circle,request.resource.data.team)
    && getAfter(/databases/$(database)/documents/circles/$(request.resource.data.circle)).data.teams[request.resource.data.team].gate == proof
    && (resource == null || request.resource.data == resource.data);
   allow delete: if circleManager(resource.data.circle,resource.data.team)
    && getAfter(/databases/$(database)/documents/circles/$(resource.data.circle)).data.teams[resource.data.team].gate != proof;
  }
  match /circles/{circle} {
   allow get: if signed() && (resource.data.get('schema',2) == 3 ? exists(/databases/$(database)/documents/circles/$(circle)/members/$(me())) : me() in resource.data.people);
   allow create: if permanent() && request.resource.data.keys().hasOnly(['name','director','createdAt','people','teams','entryCount','lastEntry','lastJoined','lastTeam'])
    && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=40
    && request.resource.data.director == me() && request.resource.data.createdAt == request.time
    && request.resource.data.people.keys() == [me()] && request.resource.data.teams.size() == 1
    && validTeam(request.resource.data.teams[request.resource.data.people[me()].team],me())
    && request.resource.data.people[me()] == {'name':profile().name,'team':request.resource.data.people[me()].team,'role':'director'}
    && request.resource.data.entryCount == 0 && request.resource.data.lastEntry == ''
    && profile().get('activeCircle','') == '' && getAfter(/databases/$(database)/documents/profiles/$(me())).data.activeCircle == circle;
   function validTeam(t,leader) { return t.keys().hasOnly(['name','leader','code','gate','open','approval']) && t.name is string && t.name.size()>0 && t.name.size()<=40 && t.leader == leader && t.code == '' && t.gate == '' && t.open == false && t.approval == false; }
   allow update: if signed() && resource.data.get('schema',2) == 2 && (admission() || teamManagement() || newEntry());
   function admission() {
    let p=request.resource.data; let changed=p.people.diff(resource.data.people).affectedKeys(); let u=p.lastJoined;
    let r=getAfter(/databases/$(database)/documents/circles/$(circle)/requests/$(u)).data;
    let oldRequest=get(/databases/$(database)/documents/circles/$(circle)/requests/$(u)).data;
    let t=resource.data.teams[r.team];
    return p.diff(resource.data).affectedKeys().hasOnly(['people','lastJoined']) && changed.hasOnly([u]) && changed.size() == 1 && !(u in resource.data.people)
     && oldRequest.status == 'pending' && r.status == 'accepted'
     && p.people[u] == {'name':r.name,'team':r.team,'role':'member'}
     && ((u == me() && t.open && !t.approval && t.gate == r.proof) || circleManager(circle,r.team));
   }
   function teamManagement() {
    let p=request.resource.data; let changed=p.teams.diff(resource.data.teams).affectedKeys(); let t=p.lastTeam; let v=p.teams[t];
    return permanent() && p.diff(resource.data).affectedKeys().hasOnly(['teams','people','lastTeam']) && changed.hasOnly([t]) && changed.size() == 1
     && ((resource.data.director == me() && !(t in resource.data.teams) && validTeam(v,me()) && p.people == resource.data.people)
      || (t in resource.data.teams && circleManager(circle,t) && v.name == resource.data.teams[t].name && v.keys().hasOnly(['name','leader','code','gate','open','approval'])
       && ((v.leader == resource.data.teams[t].leader && p.people == resource.data.people && v.open is bool && v.approval is bool
         && v.code.matches('^[A-Z0-9]{8,16}$') && v.gate.matches('^[a-f0-9]{64}$')
         && getAfter(/databases/$(database)/documents/circleGates/$(v.gate)).data == {'circle':circle,'team':t,'code':v.code})
        || (resource.data.director == me() && v.diff(resource.data.teams[t]).affectedKeys().hasOnly(['leader']) && promotion(p,v,t)))));
   }
   function promotion(p,v,t) {
    let old=resource.data.teams[t].leader; let next=v.leader;
    return next != resource.data.director && next in resource.data.people && resource.data.people[next].team == t
     && get(/databases/$(database)/documents/profiles/$(next)).data.get('accountKind','permanent') == 'permanent'
     && p.people.diff(resource.data.people).affectedKeys().hasOnly([old,next])
     && p.people[next] == {'name':resource.data.people[next].name,'team':t,'role':'leader'}
     && (old == resource.data.director ? p.people[old] == resource.data.people[old] : p.people[old] == {'name':resource.data.people[old].name,'team':t,'role':'member'});
   }
   function newEntry() { let p=request.resource.data; return circleMember(circle) && p.diff(resource.data).affectedKeys().hasOnly(['entryCount','lastEntry'])
    && p.entryCount == resource.data.entryCount+1 && validKey(p.lastEntry)
    && !exists(/databases/$(database)/documents/circles/$(circle)/entries/$(p.lastEntry))
    && getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(p.lastEntry)).data.author == me(); }
   match /requests/{uid} {
    allow get: if signed() && (uid == me() || circleManager(circle,resource.data.team));
    allow list: if circleMember(circle) && request.query.limit<=100 && (circleData(circle).director == me() || circleManager(circle,resource.data.team));
    allow create: if circleData(circle).get('schema',2) == 2 && signed() && uid == me() && request.resource.data.keys().hasOnly(['uid','name','team','proof','createdAt','status'])
     && request.resource.data.uid == me() && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=40
     && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
     && request.resource.data.proof.matches('^[a-f0-9]{64}$')
     && circleData(circle).teams[request.resource.data.team].open
     && circleData(circle).teams[request.resource.data.team].gate == request.resource.data.proof
     && get(/databases/$(database)/documents/circleGates/$(request.resource.data.proof)).data == {'circle':circle,'team':request.resource.data.team,'code':circleData(circle).teams[request.resource.data.team].code}
     && profile().get('activeCircle','') in ['',circle];
    allow update: if circleData(circle).get('schema',2) == 2 && signed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
     && getAfter(/databases/$(database)/documents/circles/$(circle)).data.people[uid] == {'name':resource.data.name,'team':resource.data.team,'role':'member'};
   }
   match /entries/{item} {
    allow get: if circleCanRead(circle,resource.data.teamId);
    allow list: if request.query.limit<=100 && circleCanRead(circle,resource.data.teamId);
    allow create: if circleData(circle).get('schema',2) == 2 && circleMember(circle) && request.resource.data.keys().hasOnly(['title','body','kind','author','authorName','teamId','createdAt','count','counts','lastTimes','comments','outcomes','source','closed'])
     && validContent(request.resource.data) && request.resource.data.author == me() && request.resource.data.authorName == circleData(circle).people[me()].name
     && (request.resource.data.teamId == circleData(circle).people[me()].team || (circleData(circle).director == me() && (request.resource.data.teamId == 'all' || request.resource.data.teamId in circleData(circle).teams)))
     && request.resource.data.createdAt == request.time && request.resource.data.count == 0 && request.resource.data.counts == {} && request.resource.data.lastTimes == {} && request.resource.data.comments == [] && request.resource.data.outcomes == {} && request.resource.data.closed == false
     && request.resource.data.source == (circleData(circle).director == me() ? '단장이 나눴어요' : circleData(circle).people[me()].role == 'leader' ? '팀장이 나눴어요' : '팀원이 나눴어요')
     && getAfter(/databases/$(database)/documents/circles/$(circle)).data.lastEntry == item && getAfter(/databases/$(database)/documents/circles/$(circle)).data.entryCount == circleData(circle).entryCount+1;
    function validContent(v) { return v.title is string && v.title.matches('.*[^\\s].*') && v.title.size()<=100 && v.body is string && v.body.size()<=3000 && v.kind in ['prayer','task']; }
    allow update: if circleData(circle).get('schema',2) == 2 && circleCanRead(circle,resource.data.teamId) && (edit() || record() || completion() || comment() || close());
    function edit() {return resource.data.author == me() && !resource.data.closed && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','body']) && validContent(request.resource.data);}
    function record() {let p=request.resource.data; return !resource.data.closed && resource.data.outcomes.get(me(),null) == null
     && p.diff(resource.data).affectedKeys().hasOnly(['count','counts','lastTimes','eventId','lastActor']) && p.lastActor == me()
     && p.count == resource.data.count+1 && p.counts.diff(resource.data.counts).affectedKeys().hasOnly([me()]) && p.counts[me()] == resource.data.counts.get(me(),0)+1
     && p.lastTimes.diff(resource.data.lastTimes).affectedKeys().hasOnly([me()]) && p.lastTimes[me()] == request.time
     && (resource.data.lastTimes.get(me(),null) == null || request.time >= resource.data.lastTimes[me()] + duration.value(3,'s'))
     && circleEvent(circle,item,p.eventId,'log');}
    function completion() {let p=request.resource.data;let o=p.outcomes[me()];return !resource.data.closed && resource.data.outcomes.get(me(),null) == null
     && p.diff(resource.data).affectedKeys().hasOnly(['outcomes','eventId','lastActor']) && p.lastActor == me() && p.outcomes.diff(resource.data.outcomes).affectedKeys().hasOnly([me()])
     && o.keys().hasOnly(['rating','count','completedAt']) && o.rating is int && o.rating>=1 && o.rating<=5 && o.completedAt == request.time && o.count == resource.data.counts.get(me(),0)
     && circleEvent(circle,item,p.eventId,'complete');}
    function comment() {let p=request.resource.data;let c=p.comments[resource.data.comments.size()];return p.diff(resource.data).affectedKeys().hasOnly(['comments'])
     && p.comments == resource.data.comments.concat([c]) && p.comments.size() == resource.data.comments.size()+1
     && c.keys().hasOnly(['id','uid','name','text','at']) && validKey(c.id) && c.uid == me() && c.name == circleData(circle).people[me()].name
     && c.text is string && c.text.size()>0 && c.text.size()<=1000 && c.at is timestamp && c.at>=request.time-duration.value(1,'m') && c.at<=request.time+duration.value(1,'m');}
    function close() {let p=request.resource.data;return !resource.data.closed && (resource.data.author == me() || circleManager(circle,resource.data.teamId))
     && p.diff(resource.data).affectedKeys().hasOnly(['closed','result','closedAt']) && p.closed == true && p.result is int && p.result>=1 && p.result<=5 && p.closedAt == request.time;}
    match /events/{event} {
     allow get: if circleMember(circle) && (resource == null || resource.data.uid == me());
     allow create: if circleData(circle).get('schema',2) == 2 && circleMember(circle) && request.resource.data.keys().hasOnly(['uid','kind','at']) && request.resource.data.uid == me() && request.resource.data.at == request.time && request.resource.data.kind in ['log','complete']
      && getAfter(/databases/$(database)/documents/profiles/$(me())).data.lastEvent == {'circle':circle,'item':item,'event':event}
      && getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.eventId == event && getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.lastActor == me();
    }
   }
  }

  // Version 3: bounded queries, unbounded document collections. No roster/count arrays grow.
  function v3(id) { return circleData(id).get('schema',2) == 3; }
  function team3(id,t) { return get(/databases/$(database)/documents/circles/$(id)/teamDocs/$(t)).data; }
  function member3(id,u) { return get(/databases/$(database)/documents/circles/$(id)/members/$(u)).data; }
  function director3(id) { return permanent() && circleData(id).director == me(); }
  function actorPath(id,item,u) { return /databases/$(database)/documents/circles/$(id)/entries/$(item)/actors/$(u); }
  match /circleGates/{proof} {
   allow create,update: if signed() && request.resource.data.get('schema',0) == 3 && proof.matches('^[a-f0-9]{64}$')
    && request.resource.data.keys().hasOnly(['circle','team','code','schema']) && request.resource.data.code.matches('^[A-Z0-9]{8,16}$')
    && (circleManager(request.resource.data.circle,request.resource.data.team) || migration3(request.resource.data.circle))
    && getAfter(/databases/$(database)/documents/circles/$(request.resource.data.circle)/teamDocs/$(request.resource.data.team)).data.gate == proof
    && (resource == null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schema']));
   allow delete: if circleManager(resource.data.circle,resource.data.team)
    && getAfter(/databases/$(database)/documents/circles/$(resource.data.circle)/teamDocs/$(resource.data.team)).data.gate != proof;
  }
  function migration3(id) { return permanent() && circleData(id).get('schema',2) == 2 && circleData(id).director == me(); }
  match /circles/{circle} {
   allow create: if permanent() && request.resource.data.keys().hasOnly(['schema','name','director','createdAt','lastEntry'])
    && request.resource.data.schema == 3 && request.resource.data.director == me() && request.resource.data.createdAt == request.time && request.resource.data.lastEntry == ''
    && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=40
    && getAfter(/databases/$(database)/documents/circles/$(circle)/members/$(me())).data.role == 'director'
    && profile().get('activeCircle','') == '' && getAfter(/databases/$(database)/documents/profiles/$(me())).data.activeCircle == circle;
   allow update: if signed() && ((resource.data.director == me() && permanent() && resource.data.get('schema',2) == 2 && request.resource.data.schema == 3 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schema']))
    || (v3(circle) && circleMember(circle) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastEntry']) && validKey(request.resource.data.lastEntry)
      && !exists(/databases/$(database)/documents/circles/$(circle)/entries/$(request.resource.data.lastEntry))
      && getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(request.resource.data.lastEntry)).data.author == me()
      && getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(request.resource.data.lastEntry)).data.createdAt == request.time));
   match /members/{uid} {
    allow get: if signed() && (uid == me() || circleMember(circle));
    allow list: if circleMember(circle) && request.query.limit<=20;
    allow create: if signed() && request.resource.data.keys().hasOnly(['name','team','role']) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=80
     && ((uid == me() && permanent() && !exists(/databases/$(database)/documents/circles/$(circle)) && request.resource.data.role == 'director'
       && getAfter(/databases/$(database)/documents/circles/$(circle)).data.director == me()
       && getAfter(/databases/$(database)/documents/circles/$(circle)/teamDocs/$(request.resource.data.team)).data.leader == me())
      || (migration3(circle) && request.resource.data == circleData(circle).people[uid])
      || (v3(circle) && admission3()));
    function admission3() {
     let r=get(/databases/$(database)/documents/circles/$(circle)/requests/$(uid)).data;let t=team3(circle,r.team);
     return r.status == 'pending' && request.resource.data == {'name':r.name,'team':r.team,'role':'member'}
      && getAfter(/databases/$(database)/documents/circles/$(circle)/requests/$(uid)).data.status == 'accepted'
      && ((uid == me() && t.open && !t.approval && t.gate == r.proof) || circleManager(circle,r.team));
    }
    allow update: if (migration3(circle) && request.resource.data == circleData(circle).people[uid]) || (v3(circle) && director3(circle) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
     && ((request.resource.data.role == 'leader' && get(/databases/$(database)/documents/profiles/$(uid)).data.get('accountKind','permanent') == 'permanent'
        && getAfter(/databases/$(database)/documents/circles/$(circle)/teamDocs/$(resource.data.team)).data.leader == uid)
      || (uid != circleData(circle).director && resource.data.role == 'leader' && request.resource.data.role == 'member'
        && getAfter(/databases/$(database)/documents/circles/$(circle)/teamDocs/$(resource.data.team)).data.leader != uid)));
   }
   match /teamDocs/{team} {
    allow get: if circleMember(circle) || (signed() && exists(/databases/$(database)/documents/circles/$(circle)/requests/$(me())) && get(/databases/$(database)/documents/circles/$(circle)/requests/$(me())).data.team == team);
    allow list: if circleMember(circle) && request.query.limit<=20;
    allow create: if signed() && request.resource.data.keys().hasOnly(['name','leader','code','gate','open','approval','parentTeam'])
     && ((request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=40
       && request.resource.data.leader == me() && request.resource.data.code == '' && request.resource.data.gate == '' && !request.resource.data.open && !request.resource.data.approval
       && ((!exists(/databases/$(database)/documents/circles/$(circle)) && permanent() && getAfter(/databases/$(database)/documents/circles/$(circle)).data.director == me()) || (v3(circle) && circleMember(circle) && request.resource.data.parentTeam == member3(circle,me()).team)))
      || (migration3(circle) && request.resource.data == circleData(circle).teams[team]));
    allow update: if (migration3(circle) && request.resource.data == circleData(circle).teams[team]) || (v3(circle) && circleManager(circle,team)
     && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gate','code','open','approval']) && request.resource.data.open is bool && request.resource.data.approval is bool
       && request.resource.data.code.matches('^[A-Z0-9]{8,16}$') && request.resource.data.gate.matches('^[a-f0-9]{64}$')
       && getAfter(/databases/$(database)/documents/circleGates/$(request.resource.data.gate)).data == {'circle':circle,'team':team,'code':request.resource.data.code,'schema':3})
      || (director3(circle) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leader'])
       && request.resource.data.leader != circleData(circle).director && member3(circle,request.resource.data.leader).team == team
       && get(/databases/$(database)/documents/profiles/$(request.resource.data.leader)).data.get('accountKind','permanent') == 'permanent'
       && getAfter(/databases/$(database)/documents/circles/$(circle)/members/$(request.resource.data.leader)).data.role == 'leader'
       && (resource.data.leader == circleData(circle).director || member3(circle,resource.data.leader).team != team || getAfter(/databases/$(database)/documents/circles/$(circle)/members/$(resource.data.leader)).data.role == 'member'))));
   }
   match /requests/{uid} {
    allow create: if v3(circle) && signed() && uid == me() && request.resource.data.keys().hasOnly(['uid','name','team','proof','createdAt','status'])
     && request.resource.data.uid == me() && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=40 && request.resource.data.createdAt == request.time && request.resource.data.status == 'pending'
     && team3(circle,request.resource.data.team).open && team3(circle,request.resource.data.team).gate == request.resource.data.proof
     && get(/databases/$(database)/documents/circleGates/$(request.resource.data.proof)).data.circle == circle && profile().get('activeCircle','') in ['',circle];
    allow update: if v3(circle) && signed() && resource.data.status == 'pending' && request.resource.data.status == 'accepted' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
     && getAfter(/databases/$(database)/documents/circles/$(circle)/members/$(uid)).data == {'name':resource.data.name,'team':resource.data.team,'role':'member'};
   }
   match /entries/{item} {
    allow create: if v3(circle) && circleMember(circle) && request.resource.data.keys().hasOnly(['schema','title','body','kind','author','authorName','teamId','createdAt','count','participantCount','commentCount','source','closed'])
     && request.resource.data.schema == 3 && content3(request.resource.data) && request.resource.data.author == me() && request.resource.data.authorName == member3(circle,me()).name
     && (request.resource.data.teamId == member3(circle,me()).team || (request.resource.data.teamId != 'all' && circleManager(circle,request.resource.data.teamId)) || (director3(circle) && request.resource.data.teamId == 'all'))
     && request.resource.data.createdAt == request.time && request.resource.data.count == 0 && request.resource.data.participantCount == 0 && request.resource.data.commentCount == 0 && request.resource.data.closed == false
     && request.resource.data.source == (director3(circle) ? '단장이 나눴어요' : circleManager(circle,request.resource.data.teamId) ? '팀장이 나눴어요' : '팀원이 나눴어요')
     && getAfter(/databases/$(database)/documents/circles/$(circle)).data.lastEntry == item;
    function content3(p) {return p.title is string && p.title.matches('.*[^\\s].*') && p.title.size()<=100 && p.body is string && p.body.size()<=3000 && p.kind in ['prayer','task'];}
    allow update: if v3(circle) && circleCanRead(circle,resource.data.teamId) && (edit3() || record3() || comment3() || close3());
    function edit3() {return !resource.data.closed && resource.data.author == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','body']) && content3(request.resource.data);}
    function record3() {
     let p=request.resource.data;let before=actorPath(circle,item,me());let a=getAfter(before).data;
     let first=!exists(before) && resource.data.get('counts',{}).get(me(),0) == 0;
     return !resource.data.closed && p.diff(resource.data).affectedKeys().hasOnly(['count','participantCount','eventId','lastActor']) && p.count == resource.data.count+1
      && p.participantCount == resource.data.get('participantCount',resource.data.get('counts',{}).size()) + (first ? 1 : 0)
      && p.lastActor == me() && a.lastEvent == p.eventId && a.lastLog == request.time && circleEvent(circle,item,p.eventId,'log');
    }
    function comment3(){let p=request.resource.data;return p.diff(resource.data).affectedKeys().hasOnly(['commentCount','lastComment'])
     && p.commentCount == resource.data.get('commentCount',resource.data.get('comments',[]).size())+1 && validKey(p.lastComment)
     && !exists(/databases/$(database)/documents/circles/$(circle)/entries/$(item)/comments/$(p.lastComment))
     && getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(item)/comments/$(p.lastComment)).data.uid == me();}
    function close3(){let p=request.resource.data;return !resource.data.closed && (resource.data.author == me() || circleManager(circle,resource.data.teamId)) && p.diff(resource.data).affectedKeys().hasOnly(['closed','result','closedAt']) && p.closed && p.result is int && p.result>=1 && p.result<=5 && p.closedAt == request.time;}
    match /actors/{uid} {
     allow get: if v3(circle) && signed() && uid == me() && circleCanRead(circle,get(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.teamId);
     allow list: if v3(circle) && circleCanRead(circle,get(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.teamId) && request.query.limit<=20;
     allow create,update: if v3(circle) && signed() && uid == me() && actor3();
     function actor3(){
      let p=request.resource.data;let e=get(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data;
      let old=resource == null ? {'count':e.get('counts',{}).get(uid,0),'lastLog':e.get('lastTimes',{}).get(uid,null),'rating':e.get('outcomes',{}).get(uid,{}).get('rating',null)} : resource.data;
      let event=getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(item)/events/$(p.lastEvent)).data;
      return circleCanRead(circle,e.teamId) && !e.closed && old.rating == null && p.keys().hasOnly(['uid','name','count','lastLog','lastEvent','rating','completedAt']) && p.uid == uid && p.name == member3(circle,uid).name
       && circleEvent(circle,item,p.lastEvent,event.kind)
       && ((event.kind == 'log' && p.count == old.count+1 && p.lastLog == request.time && p.rating == null && p.completedAt == null
         && (old.lastLog == null || request.time>=old.lastLog+duration.value(3,'s')) && getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.eventId == p.lastEvent)
        || (event.kind == 'complete' && p.count == old.count && p.lastLog == old.lastLog && p.rating is int && p.rating>=1 && p.rating<=5 && p.completedAt == request.time));
     }
    }
    match /comments/{comment} {
     allow get,list: if v3(circle) && circleCanRead(circle,get(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.teamId) && (request.method == 'get' || request.query.limit<=20);
     allow create: if v3(circle) && circleCanRead(circle,get(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.teamId)
      && request.resource.data.keys().hasOnly(['uid','name','text','at']) && request.resource.data.uid == me() && request.resource.data.name == member3(circle,me()).name
      && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=1000 && request.resource.data.at == request.time
      && getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.lastComment == comment
      && getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.commentCount == get(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.get('commentCount',get(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.get('comments',[]).size())+1;
    }
    match /events/{event} {
     allow create: if v3(circle) && circleMember(circle) && request.resource.data.keys().hasOnly(['uid','kind','at']) && request.resource.data.uid == me() && request.resource.data.at == request.time && request.resource.data.kind in ['log','complete']
      && getAfter(/databases/$(database)/documents/profiles/$(me())).data.lastEvent == {'circle':circle,'item':item,'event':event}
      && getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(item)/actors/$(me())).data.lastEvent == event
      && (request.resource.data.kind == 'log' ? getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(item)).data.eventId == event : getAfter(/databases/$(database)/documents/circles/$(circle)/entries/$(item)/actors/$(me())).data.completedAt == request.time);
    }
   }
  }

  match /{document=**} { allow read,write: if false; }
 }
}
